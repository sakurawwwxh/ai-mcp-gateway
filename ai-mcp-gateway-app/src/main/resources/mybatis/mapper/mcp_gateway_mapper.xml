<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.tomato.ai.infrastructure.dao.IMcpGatewayDao">

    <resultMap id="McpGatewayMap" type="cn.tomato.ai.infrastructure.dao.po.McpGatewayPO">
        <id column="id" property="id"/>
        <result column="gateway_id" property="gatewayId"/>
        <result column="gateway_name" property="gatewayName"/>
        <result column="gateway_desc" property="gatewayDesc"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="cn.tomato.ai.infrastructure.dao.po.McpGatewayPO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO mcp_gateway (gateway_id, gateway_name, gateway_desc, status)
        VALUES (#{gatewayId}, #{gatewayName}, #{gatewayDesc}, #{status})
    </insert>

    <update id="updateById" parameterType="cn.tomato.ai.infrastructure.dao.po.McpGatewayPO">
        UPDATE mcp_gateway
        <set>
            <if test="gatewayName != null">gateway_name = #{gatewayName},</if>
            <if test="gatewayDesc != null">gateway_desc = #{gatewayDesc},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM mcp_gateway WHERE id = #{id}
    </delete>

    <select id="queryById" resultMap="McpGatewayMap">
        SELECT id, gateway_id, gateway_name, gateway_desc, status, create_time, update_time
        FROM mcp_gateway
        WHERE id = #{id}
    </select>

    <select id="queryAll" resultMap="McpGatewayMap">
        SELECT id, gateway_id, gateway_name, gateway_desc, status, create_time, update_time
        FROM mcp_gateway
    </select>

    <select id="queryMcpGatewayByGatewayId" parameterType="java.lang.String" resultMap="McpGatewayMap">
        SELECT id, gateway_id, gateway_name, gateway_desc, status
        FROM mcp_gateway
        WHERE gateway_id = #{gatewayId}
    </select>

</mapper>
